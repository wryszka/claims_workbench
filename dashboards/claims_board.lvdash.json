{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "ds_kpi",
      "queryLines": [
        "SELECT sum(CASE WHEN claim_status IN ('open','under_investigation') THEN 1 ELSE 0 END) AS open_claims, sum(CASE WHEN claim_status IN ('open','under_investigation') AND datediff(current_date(),report_date) > CASE peril_type WHEN 'motor_tp' THEN 30 WHEN 'home_fire' THEN 60 ELSE 45 END THEN 1 ELSE 0 END) AS aged_past_sla FROM `lr_dev_aws_us_catalog`.`claims_workbench`.silver_claims_enriched"
      ]
    },
    {
      "name": "ds_autoclose",
      "displayName": "ds_autoclose",
      "queryLines": [
        "SELECT round(100.0*avg(CASE WHEN disposition='auto_closed' THEN 1 ELSE 0 END),1) AS pct_auto_closed FROM `lr_dev_aws_us_catalog`.`claims_workbench`.gold_claim_disposition"
      ]
    },
    {
      "name": "ds_status",
      "displayName": "ds_status",
      "queryLines": [
        "SELECT claim_status, count(*) AS n FROM `lr_dev_aws_us_catalog`.`claims_workbench`.silver_claims_enriched GROUP BY claim_status ORDER BY n DESC"
      ]
    },
    {
      "name": "ds_open_peril",
      "displayName": "ds_open_peril",
      "queryLines": [
        "SELECT peril_type, count(*) AS open_claims FROM `lr_dev_aws_us_catalog`.`claims_workbench`.silver_claims_enriched WHERE claim_status IN ('open','under_investigation') GROUP BY peril_type ORDER BY open_claims DESC"
      ]
    },
    {
      "name": "ds_open_age",
      "displayName": "ds_open_age",
      "queryLines": [
        "SELECT CASE WHEN datediff(current_date(),report_date)<=30 THEN '0-30 days' WHEN datediff(current_date(),report_date)<=90 THEN '31-90 days' WHEN datediff(current_date(),report_date)<=180 THEN '91-180 days' ELSE '180+ days' END AS age_bucket, count(*) AS n FROM `lr_dev_aws_us_catalog`.`claims_workbench`.silver_claims_enriched WHERE claim_status IN ('open','under_investigation') GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "ds_team",
      "displayName": "ds_team",
      "queryLines": [
        "SELECT coalesce(h.team,'unassigned') AS team, count(*) AS open_claims FROM `lr_dev_aws_us_catalog`.`claims_workbench`.silver_claims_enriched s LEFT JOIN `lr_dev_aws_us_catalog`.`claims_workbench`.ref_handlers h ON s.handler_id=h.handler_id WHERE s.claim_status IN ('open','under_investigation') GROUP BY h.team ORDER BY open_claims DESC"
      ]
    },
    {
      "name": "ds_handler_kpi",
      "displayName": "ds_handler_kpi",
      "queryLines": [
        "SELECT count(*) AS handlers, sum(caseload) AS caseload, round(avg(avg_days_to_settle),1) AS avg_settle, round(avg(leakage_rate_pct),1) AS leakage FROM `lr_dev_aws_us_catalog`.`claims_workbench`.gold_handler_scorecard"
      ]
    },
    {
      "name": "ds_team_perf",
      "displayName": "ds_team_perf",
      "queryLines": [
        "SELECT team, round(avg(leakage_rate_pct),1) AS leakage_pct, sum(caseload) AS caseload FROM `lr_dev_aws_us_catalog`.`claims_workbench`.gold_handler_scorecard GROUP BY team ORDER BY leakage_pct DESC"
      ]
    },
    {
      "name": "ds_handler_top",
      "displayName": "ds_handler_top",
      "queryLines": [
        "SELECT handler_name, leakage_rate_pct FROM `lr_dev_aws_us_catalog`.`claims_workbench`.gold_handler_scorecard ORDER BY leakage_rate_pct DESC LIMIT 12"
      ]
    },
    {
      "name": "ds_trends",
      "displayName": "ds_trends",
      "queryLines": [
        "SELECT snapshot_date, pct_auto_closed, leakage_rate, avg_settle_days, sla_breach_pct FROM `lr_dev_aws_us_catalog`.`claims_workbench`.gold_cco_metrics_daily ORDER BY snapshot_date"
      ]
    }
  ],
